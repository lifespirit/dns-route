{{define "stats.html.tmpl"}}
{{template "admin_header" .}}
<div class="card">
  <h2>Runtime</h2>
  <table>
    <tr><td>Started at</td><td>{{.StartedAt}}</td></tr>
    <tr><td>Uptime</td><td>{{.Uptime}}</td></tr>
    <tr><td>Cache entries</td><td>{{.CacheEntries}}</td></tr>
    <tr><td>Active listeners</td><td>{{.ActiveListeners}}</td></tr>
    <tr><td>Pending listeners</td><td>{{.PendingListeners}}</td></tr>
    <tr><td>Backend snapshot entries</td><td>{{.RouteSnapshot}} <small>(sum across active backends)</small></td></tr>
    <tr><td>Kernel route snapshot entries</td><td>{{.KernelRouteSnapshot}}</td></tr>
    <tr><td>IP cache entries</td><td>{{.IPCacheEntries}}</td></tr>
    <tr><td>Route prefix cache entries</td><td>{{.CIDRCacheEntries}}</td></tr>
  </table>
</div>

<div class="card section-gap">
  <h2>Configuration</h2>
  <table>
    <tr><td>Listen addrs</td><td>{{.ListenAddrs}}</td></tr>
    <tr><td>Default upstreams</td><td>{{.Upstreams}}</td></tr>
    <tr><td>Conditional forward zones</td><td>{{.ActiveForwardZones}} active / {{.ForwardZones}} configured</td></tr>
    <tr><td>Conditional forward upstreams</td><td>{{.ForwardUpstreams}}</td></tr>
    <tr><td>Special domains</td><td>{{.SpecialDomains}}</td></tr>
    <tr><td>Special-domain sources</td><td>{{.LoadedSpecialDomainSources}} loaded / {{.SpecialDomainSources}} configured</td></tr>
    <tr><td>Local DNS domains</td><td>{{.LocalDNSDomains}} unique</td></tr>
    <tr><td>Local A domains</td><td>{{.LocalADomains}}</td></tr>
    <tr><td>Local AAAA domains</td><td>{{.LocalAAAADomains}}</td></tr>
    <tr><td>DNS-record sources</td><td>{{.LoadedDNSRecordSources}} loaded / {{.DNSRecordSources}} configured</td></tr>
    <tr><td>Team Cymru prefix lookup</td><td>{{.LookupCIDR}}</td></tr>
    <tr><td>Reply before route</td><td>{{.ReplyBeforeRoute}}</td></tr>
    <tr><td>Listener freebind</td><td>{{.ListenerFreeBind}}</td></tr>
    <tr><td>Route mode</td><td>{{.RouteMode}}</td></tr>
    <tr><td>Route IPv4</td><td>{{.RouteIPv4}}</td></tr>
    <tr><td>Route IPv6</td><td>{{.RouteIPv6}}</td></tr>
    <tr><td>Route table</td><td>{{.RouteTable}}{{if ne .RouteTableConfigured .RouteTable}} <small>(configured: {{.RouteTableConfigured}})</small>{{end}}</td></tr>
    <tr><td>WG interface</td><td>{{.WGInterface}}</td></tr>
    <tr><td>WG gateway v4</td><td>{{.WGGatewayV4}}</td></tr>
    <tr><td>WG gateway v6</td><td>{{.WGGatewayV6}}</td></tr>
  </table>
</div>

<div class="card section-gap">
  <h2>BGP</h2>
  <table>
    <tr><td>Status</td><td>{{if .BGP.Enabled}}<span class="badge {{.BGP.State}}">{{.BGP.State}}</span>{{else}}<span class="badge disabled">disabled</span>{{end}}</td></tr>
    {{if .BGP.Enabled}}
    <tr><td>Backend ready</td><td>{{.BGP.Ready}}{{if .BGP.RequireEstablished}} <small>(requires Established)</small>{{end}}</td></tr>
    <tr><td>Local</td><td>AS{{.BGP.LocalASN}} / router-id {{.BGP.RouterID}}{{if .BGP.LocalAddress}} / source {{.BGP.LocalAddress}}{{end}}</td></tr>
    <tr><td>Peer</td><td>{{.BGP.PeerAddress}} AS{{.BGP.PeerASN}}</td></tr>
    <tr><td>Next hop IPv4</td><td>{{.BGP.NextHopV4}}</td></tr>
    <tr><td>Next hop IPv6</td><td>{{.BGP.NextHopV6}}</td></tr>
    <tr><td>eBGP multihop TTL</td><td>{{.BGP.MultihopTTL}}</td></tr>
    <tr><td>TCP MD5 password</td><td>{{if .BGP.PasswordConfigured}}configured{{else}}not configured{{end}}</td></tr>
    <tr><td>Desired prefixes</td><td>{{.BGP.DesiredPrefixes}}</td></tr>
    <tr><td>Loc-RIB prefixes</td><td>{{.BGP.AnnouncedPrefixes}}</td></tr>
    {{end}}
  </table>
</div>

<div class="card section-gap">
  <h2>Counters</h2>
  <table>
    <tr><td>Total queries</td><td>{{.TotalQueries}}</td></tr>
    <tr><td>Cache hits</td><td>{{.CacheHits}}</td></tr>
    <tr><td>Cache misses</td><td>{{.CacheMisses}}</td></tr>
    <tr><td>Local answers</td><td>{{.LocalAnswers}}</td></tr>
    <tr><td>Forwarded OK</td><td>{{.ForwardedOK}}</td></tr>
    <tr><td>SERVFAIL</td><td>{{.ServfailCount}}</td></tr>
    <tr><td>Forward errors</td><td>{{.ForwardErrors}}</td></tr>
    <tr><td>Kernel route replacements</td><td>{{.RouteAdds}}</td></tr>
    <tr><td>Kernel route replacement errors</td><td>{{.RouteAddErrors}}</td></tr>
    <tr><td>Route queue drops</td><td>{{.RouteQueueDrops}}</td></tr>
    <tr><td>Conntrack reset attempts</td><td>{{.ConntrackResetAttempts}}</td></tr>
    <tr><td>Conntrack flows deleted</td><td>{{.ConntrackResetDeleted}}</td></tr>
    <tr><td>Conntrack reset errors</td><td>{{.ConntrackResetErrors}}</td></tr>
    <tr><td>Listener bind attempts</td><td>{{.ListenerBindAttempts}}</td></tr>
    <tr><td>Listener bind errors</td><td>{{.ListenerBindErrors}}</td></tr>
    <tr><td>Listener starts</td><td>{{.ListenerStarts}}</td></tr>
    <tr><td>Listener recoveries</td><td>{{.ListenerRecoveries}}</td></tr>
    <tr><td>Team Cymru lookup attempts</td><td>{{.LookupCIDRAttempts}}</td></tr>
    <tr><td>Team Cymru lookup failed</td><td>{{.LookupCIDRFailed}}</td></tr>
  </table>
</div>

<div class="card section-gap">
  <h2>Outbound policies</h2>
  <table>
    <tr><th>Policy</th><th>Selected</th><th>Success</th><th>DNS errors</th><th>Transport errors</th></tr>
    {{range .ForwardPolicies}}
    <tr><td>{{if eq .Policy "default"}}default{{else}}*.{{.Policy}}{{end}}</td><td>{{.Selected}}</td><td>{{.Success}}</td><td>{{.DNSFailures}}</td><td>{{.Errors}}</td></tr>
    {{else}}<tr><td colspan="5" class="muted">No forwarding policies.</td></tr>{{end}}
  </table>
</div>

<div class="card section-gap">
  <h2>Listeners</h2>
  <table>
    <tr><th>Network</th><th>Address</th><th>State</th><th>FreeBind</th><th>Attempts / time</th><th>Last error</th></tr>
    {{range .ListenerStates}}
    <tr>
      <td>{{.Net}}</td>
      <td>{{.Addr}}</td>
      <td><span class="badge {{.State}}">{{.State}}</span></td>
      <td>{{.FreeBind}}</td>
      <td>{{if eq .State "active"}}started: {{.StartedAt}}{{else}}attempts: {{.Attempts}}<br>last: {{.LastAttempt}}{{end}}</td>
      <td class="error-text">{{if .LastError}}{{.LastError}}{{else}}<span class="muted">—</span>{{end}}</td>
    </tr>
    {{else}}<tr><td colspan="6" class="muted">No listener sockets configured.</td></tr>{{end}}
  </table>
</div>

<div class="card section-gap">
  <h2>Upstream circuit breakers</h2>
  <table>
    <tr>
      <th>Upstream</th><th>Scopes</th><th>Protocol</th><th>State</th><th>Consecutive failures</th>
      <th>Requests</th><th>Skipped</th><th>Open / recover</th><th>Last activity</th><th>Last error</th>
    </tr>
    {{range .UpstreamCircuits}}
    <tr>
      <td><strong>{{.Addr}}</strong><br><small>{{.Endpoint}}</small></td>
      <td>{{.Scopes}}</td>
      <td>{{.ConfiguredProto}} → {{.Proto}}</td>
      <td class="nowrap"><span class="badge {{.State}}">{{.State}}</span>{{if ne .OpenRemaining "—"}}<br><small>{{.OpenRemaining}} remaining</small>{{end}}</td>
      <td>{{.ConsecutiveFailures}}</td>
      <td>OK: {{.Successes}}<br>transport errors: {{.Failures}}<br>DNS errors: {{.DNSFailures}}</td>
      <td>{{.Skipped}}<br><small>half-open probes: {{.HalfOpenProbes}}</small></td>
      <td>opened: {{.OpenEvents}}<br>recovered: {{.Recoveries}}</td>
      <td>success: {{.LastSuccess}}<br>failure: {{.LastFailure}}</td>
      <td class="error-text">{{if .LastError}}{{.LastError}}{{else}}<span class="muted">—</span>{{end}}</td>
    </tr>
    {{else}}<tr><td colspan="10" class="muted">No upstreams configured.</td></tr>{{end}}
  </table>
</div>
{{template "admin_footer" .}}
{{end}}
