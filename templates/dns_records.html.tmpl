{{define "dns_records.html.tmpl"}}
{{template "admin_header" .}}
{{$return := .RecordReturnURL}}
<div class="card">
  <h2>DNS records</h2>
  <form id="record-add-form" method="post" action="/record/add">
    <input type="hidden" name="return" value="{{$return}}">
    <table>
      <tr>
        <td><input type="text" name="name" placeholder="example.com or *.example.com" required></td>
        <td><select name="type"><option value="A">A</option><option value="AAAA">AAAA</option></select></td>
        <td><input type="text" name="value" placeholder="10.0.0.1, 2001:db8::1, or empty=NODATA"></td>
        <td><input type="number" min="0" name="ttl" placeholder="0"></td>
      </tr>
    </table>
  </form>
  <div class="actions" aria-label="DNS record actions">
    <button type="submit" form="record-add-form">Add record</button>
    <form id="record-import-form" class="inline" method="post" action="/record/import" enctype="multipart/form-data">
      <input type="hidden" name="return" value="{{$return}}">
      <input id="record-import-file" class="visually-hidden" type="file" name="file" accept=".csv,text/csv,text/plain" required onchange="if (this.files.length) this.form.submit()">
    </form>
    <button type="button" onclick="document.getElementById('record-import-file').click()">Import CSV</button>
    <form class="inline" method="get" action="/record/export"><button type="submit">Export CSV</button></form>
  </div>
  <p><small>Import replaces every persistent A/AAAA record for each name present in the selected file. Export downloads the persistent database records only.</small></p>

  <form method="get" action="/dns-records" class="search-row">
    <label>Search domains
      <input id="record-domain-search" type="text" name="q" value="{{.RecordQuery}}" placeholder="substring or /regexp/" maxlength="512">
    </label>
    <button type="submit">Search</button>
    <button type="button" onclick="document.getElementById('record-domain-search').value=''; this.form.submit()">Clear</button>
  </form>
  <p><small>Plain text performs a case-insensitive substring search. Expressions wrapped in slashes use Go RE2 syntax, for example <code>/^ads\..*\.lan$/</code>.</small></p>
  {{if .RecordSearchError}}<div class="search-error">{{.RecordSearchError}}</div>{{end}}

  <div class="pagination">
    <span>{{.RecordTotalDomains}} domains · page {{.RecordPage}} of {{.RecordTotalPages}}</span>
    <span class="pagination-links">
      {{if .RecordHasPrev}}<a href="{{.RecordPrevURL}}">Previous</a>{{else}}<span class="muted">Previous</span>{{end}}
      {{if .RecordHasNext}}<a href="{{.RecordNextURL}}">Next</a>{{else}}<span class="muted">Next</span>{{end}}
    </span>
  </div>

  <table>
    <tr><th>Type</th><th>Value</th><th>TTL</th><th>Source</th><th>Status</th><th>Action</th></tr>
    {{range .RecordDomains}}
      <tr class="domain-heading"><td colspan="6">{{.Name}}</td></tr>
      {{range .Records}}
      <tr>
        <td>{{.Type}}</td>
        <td>{{if .Value}}{{.Value}}{{else}}<span class="badge disabled">NODATA</span>{{end}}</td>
        <td>{{if .DefaultTTL}}default ({{.TTL}}){{else}}{{.TTL}}{{end}}</td>
        <td class="source-cell">
          {{if .Persistent}}
            <span class="badge disabled">database</span>
          {{else}}
            <a href="#record-source-{{.SourceID}}"><span class="badge source">{{.SourceKind}} #{{.SourceID}}</span></a>
            <small class="source-location">{{.Source}}</small>
          {{end}}
        </td>
        <td>
          {{if eq .Status "active"}}<span class="badge active">active</span>
          {{else if eq .Status "overridden"}}<span class="badge overridden">overridden</span>
          {{else if eq .Status "disabled"}}<span class="badge disabled">disabled</span>
          {{else}}<span class="badge invalid">invalid</span>{{end}}
        </td>
        <td>
          {{if .Persistent}}
          <form class="inline" method="post" action="/record/delete">
            <input type="hidden" name="return" value="{{$return}}">
            <input type="hidden" name="id" value="{{.ID}}">
            <button type="submit">Delete</button>
          </form>
          {{else}}<span class="muted">Managed by source</span>{{end}}
        </td>
      </tr>
      {{end}}
    {{else}}<tr><td colspan="6" class="muted">No matching DNS records.</td></tr>{{end}}
  </table>

  <div class="pagination">
    <span>{{.RecordTotalDomains}} domains · page {{.RecordPage}} of {{.RecordTotalPages}}</span>
    <span class="pagination-links">
      {{if .RecordHasPrev}}<a href="{{.RecordPrevURL}}">Previous</a>{{else}}<span class="muted">Previous</span>{{end}}
      {{if .RecordHasNext}}<a href="{{.RecordNextURL}}">Next</a>{{else}}<span class="muted">Next</span>{{end}}
    </span>
  </div>
</div>

<div class="card section-gap">
  <div class="section-title-row">
    <h2>External CSV sources</h2>
  </div>
  <form method="post" action="/record/source/add" class="source-form-grid">
    <input type="hidden" name="return" value="{{$return}}">
    <label>HTTP(S) URL or filesystem path<input type="text" name="location" placeholder="https://example/list.csv or /etc/dns-route/records.csv" required></label>
    <label class="checkbox-field"><input type="checkbox" name="no_data_only" value="1"> NO_DATA only</label>
    <button type="submit">Add / update source</button>
  </form>
  <p><small>Reload config reuses the current in-memory source snapshot and performs no file or network I/O. Reload sources explicitly downloads HTTP sources and rereads local files, then atomically replaces the snapshot. If source reload fails, the previous snapshot remains active. Later sources override earlier sources, while enabled local database records have final priority per name and type. NO_DATA only ignores address columns and prevents DNS-address injection.</small></p>

  <table>
    <tr><th>ID</th><th>Location</th><th>Kind</th><th>Loaded</th><th>Mode</th><th>Actions</th></tr>
    {{range .DNSRecordSources}}
    <tr id="record-source-{{.ID}}">
      <td>{{.ID}}</td>
      <td class="error-text">{{.Location}}</td>
      <td>{{.Kind}}</td>
      <td>{{if .Loaded}}{{.Domains}} names / {{.Records}} records{{else}}<span class="badge pending">Pending refresh</span>{{end}}</td>
      <td>{{if .NoDataOnly}}<span class="badge active">NO_DATA only</span>{{else}}normal{{end}}</td>
      <td class="nowrap">
        <form class="inline" method="post" action="/record/source/update">
          <input type="hidden" name="return" value="{{$return}}">
          <input type="hidden" name="id" value="{{.ID}}">
          <label><input type="checkbox" name="no_data_only" value="1" {{if .NoDataOnly}}checked{{end}}> NO_DATA only</label>
          <button type="submit">Update</button>
        </form>
        <form class="inline" method="post" action="/record/source/delete">
          <input type="hidden" name="return" value="{{$return}}">
          <input type="hidden" name="id" value="{{.ID}}">
          <button type="submit">Delete</button>
        </form>
      </td>
    </tr>
    {{else}}<tr><td colspan="6" class="muted">No external DNS-record sources configured.</td></tr>{{end}}
  </table>
</div>
{{template "admin_footer" .}}
{{end}}
