{{define "admin_header"}}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}} · dns-route</title>
<style>
:root { color-scheme: light dark; }
* { box-sizing: border-box; }
html, body { min-height: 100%; }
body { font-family: system-ui, sans-serif; margin: 0; line-height: 1.4; display: flex; flex-direction: column; }
h1, h2 { margin-top: 0; }
h1 { margin-bottom: 2px; font-size: 1.45rem; }
h2 { font-size: 1.2rem; }
h3 { margin-bottom: 6px; }
a { color: inherit; }
.topbar { border-bottom: 1px solid #8886; padding: 16px 24px; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
.brand small { opacity: .72; }
.header-controls { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 12px; }
.nav { display: flex; flex-wrap: wrap; gap: 6px; }
.nav a { text-decoration: none; padding: 7px 10px; border-radius: 8px; }
.nav a:hover { background: #8882; }
.nav a.active { background: #8883; font-weight: 650; }
.header-actions { display: flex; flex-wrap: wrap; gap: 8px; }
.container { width: min(1500px, 100%); margin: 0 auto; padding: 24px; flex: 1; }
table { border-collapse: collapse; width: 100%; margin-top: 8px; }
th, td { border: 1px solid #8886; padding: 8px; text-align: left; vertical-align: top; }
th { background: #8882; }
input[type=text], input[type=password], input[type=number], select { width: 100%; box-sizing: border-box; padding: 7px; }
input[type=checkbox] { transform: translateY(1px); }
form.inline { display: inline; margin: 0; }
.grid { display: grid; grid-template-columns: repeat(2, minmax(300px, 1fr)); gap: 16px; }
.card { border: 1px solid #8886; padding: 16px; border-radius: 10px; overflow-x: auto; }
.section-gap { margin-top: 24px; }
.section-title-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }
.section-title-row h2 { margin-bottom: 0; }
small, .muted { opacity: .72; }
button { padding: 7px 11px; cursor: pointer; }
.actions { margin-top: 16px; display: flex; flex-wrap: wrap; gap: 8px; }
.form-grid { display: grid; grid-template-columns: minmax(220px, 1fr) 140px auto; gap: 8px; align-items: end; }
.forward-grid { grid-template-columns: minmax(180px, .7fr) minmax(260px, 1fr) 140px auto; }
.badge { display: inline-block; padding: 2px 7px; border-radius: 999px; font-size: .82rem; font-weight: 600; }
.badge.closed, .badge.active, .badge.established { background: #2e7d3230; }
.badge.open { background: #c6282830; }
.badge.half_open, .badge.pending, .badge.down, .badge.unavailable { background: #ef6c0030; }
.badge.overridden { background: #ef6c0030; }
.badge.invalid { background: #c6282830; }
.badge.source { background: #1565c030; }
.badge.disabled { background: #8883; }
.nowrap { white-space: nowrap; }
.error-text { max-width: 520px; overflow-wrap: anywhere; }
.visually-hidden { position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
.source-cell { min-width: 190px; }
.source-location { display: block; margin-top: 4px; max-width: 360px; overflow-wrap: anywhere; }
.source-form-grid { display: grid; grid-template-columns: minmax(280px, 1fr) auto auto; gap: 12px; align-items: end; }
.checkbox-field { padding-bottom: 8px; white-space: nowrap; }
.site-footer { border-top: 1px solid #8886; padding: 14px 24px; }
.footer-inner { width: min(1500px, 100%); margin: 0 auto; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }
.footer-links { display: flex; flex-wrap: wrap; gap: 12px; }
.search-row { display: grid; grid-template-columns: minmax(240px, 1fr) auto auto; gap: 8px; align-items: end; margin-top: 16px; }
.pagination { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-top: 14px; }
.pagination-links { display: flex; gap: 8px; align-items: center; }
.domain-heading td { background: #8882; font-weight: 650; }
.search-error { margin-top: 10px; padding: 8px 10px; border: 1px solid #c6282860; border-radius: 8px; background: #c6282815; }
@media (max-width: 900px) {
  .topbar, .container, .site-footer { padding-left: 12px; padding-right: 12px; }
  .header-controls { width: 100%; justify-content: flex-start; }
  .grid { grid-template-columns: 1fr; }
  .form-grid, .forward-grid, .source-form-grid, .search-row { grid-template-columns: 1fr; }
  .checkbox-field { padding-bottom: 0; }
}
</style>
</head>
<body>
<header class="topbar">
  <div class="brand">
    <h1>dns-route</h1>
    <small>HTTP panel: {{.Message}}</small>
  </div>
  <div class="header-controls">
    <nav class="nav" aria-label="Admin sections">
      <a href="/" {{if eq .Path "/"}}class="active"{{end}}>Runtime</a>
      <a href="/settings" {{if eq .Path "/settings"}}class="active"{{end}}>Settings</a>
      <a href="/upstreams" {{if eq .Path "/upstreams"}}class="active"{{end}}>Upstreams</a>
      <a href="/special-domains" {{if eq .Path "/special-domains"}}class="active"{{end}}>Special domains</a>
      <a href="/dns-records" {{if eq .Path "/dns-records"}}class="active"{{end}}>DNS records</a>
      <a href="/statistics" {{if eq .Path "/statistics"}}class="active"{{end}}>Statistics</a>
    </nav>
    <div class="header-actions" aria-label="Runtime actions">
      <form class="inline" method="post" action="/reload"><input type="hidden" name="return" value="{{.Path}}"><button type="submit">Reload config</button></form>
      <form class="inline" method="post" action="/routes/reload"><input type="hidden" name="return" value="{{.Path}}"><button type="submit">Reload routes</button></form>
    </div>
  </div>
</header>
<main class="container">
{{end}}

{{define "admin_footer"}}
</main>
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-links">
      <a href="/metrics" target="_blank" rel="noopener">Prometheus metrics</a>
      <a href="/routes/errors" target="_blank" rel="noopener">Route error log</a>
    </div>
  </div>
</footer>
</body>
</html>
{{end}}
