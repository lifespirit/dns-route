{{define "admin.html.tmpl"}}
{{template "admin_header" .}}
<div class="card">
  <h2>Runtime</h2>
  <table>
    <tr><td>Listen addrs</td><td>{{len .Config.ListenAddrs}}</td></tr>
    <tr><td>Default upstreams</td><td>{{len .Config.Upstreams}}</td></tr>
    <tr><td>Conditional forward zones</td><td>{{len .ForwardZones}}</td></tr>
    <tr><td>Special domains</td><td>{{len .SpecialDomains}}</td></tr>
    <tr><td>Local A domains</td><td>{{len .Config.LocalA}}</td></tr>
    <tr><td>Local AAAA domains</td><td>{{len .Config.LocalAAAA}}</td></tr>
    <tr><td>Route mode</td><td>{{.Config.RouteMode}}</td></tr>
    <tr><td>Route table</td><td>{{.Config.RouteTable}}</td></tr>
    <tr><td>Route IPv4</td><td>{{.Config.RouteIPv4}}</td></tr>
    <tr><td>Route IPv6</td><td>{{.Config.RouteIPv6}}</td></tr>
    <tr><td>Team Cymru prefix lookup</td><td>{{.Config.LookupCIDR}}</td></tr>
    <tr><td>Reply before route</td><td>{{.Config.ReplyBeforeRoute}}</td></tr>
    <tr><td>Listener freebind</td><td>{{.Config.ListenerFreeBind}}</td></tr>
    <tr><td>WG interface</td><td>{{.Config.WGInterface}}</td></tr>
    <tr><td>WG gateway v4</td><td>{{.Config.WGGatewayV4}}</td></tr>
    <tr><td>WG gateway v6</td><td>{{.Config.WGGatewayV6}}</td></tr>
    <tr><td>BGP peer</td><td>{{if .BGP.Enabled}}<span class="badge {{.BGP.State}}">{{.BGP.State}}</span> {{.BGP.PeerAddress}} AS{{.BGP.PeerASN}}{{else}}<span class="badge disabled">disabled</span>{{end}}</td></tr>
    <tr><td>BGP prefixes</td><td>desired: {{.BGP.DesiredPrefixes}}<br>Loc-RIB: {{.BGP.AnnouncedPrefixes}}</td></tr>
    <tr><td>BGP backend ready</td><td>{{.BGP.Ready}}{{if .BGP.RequireEstablished}} <small>(requires Established)</small>{{end}}</td></tr>
  </table>
</div>
{{template "admin_footer" .}}
{{end}}
