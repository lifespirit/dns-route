<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>dns-route admin</title>
<style>
:root { color-scheme: light dark; }
body { font-family: system-ui, sans-serif; margin: 24px; line-height: 1.4; }
h1, h2 { margin-top: 0; }
h2 { font-size: 1.2rem; }
table { border-collapse: collapse; width: 100%; margin-top: 8px; }
th, td { border: 1px solid #8886; padding: 8px; text-align: left; vertical-align: top; }
th { background: #8882; }
input[type=text], input[type=number], select { width: 100%; box-sizing: border-box; padding: 7px; }
input[type=checkbox] { transform: translateY(1px); }
form.inline { display: inline; margin: 0; }
.grid { display: grid; grid-template-columns: repeat(2, minmax(300px, 1fr)); gap: 16px; }
.card { border: 1px solid #8886; padding: 16px; border-radius: 10px; overflow-x: auto; }
.section-gap { margin-top: 24px; }
small, .muted { opacity: .72; }
button { padding: 7px 11px; cursor: pointer; }
.actions { margin-top: 16px; display: flex; flex-wrap: wrap; gap: 8px; }
.form-grid { display: grid; grid-template-columns: minmax(220px, 1fr) 140px auto; gap: 8px; align-items: end; }
.forward-grid { grid-template-columns: minmax(180px, .7fr) minmax(260px, 1fr) 140px auto; }
.badge { display: inline-block; padding: 2px 7px; border-radius: 999px; font-size: .82rem; font-weight: 600; }
.badge.closed { background: #2e7d3230; }
.badge.open { background: #c6282830; }
.badge.half_open { background: #ef6c0030; }
.badge.active { background: #2e7d3230; }
.badge.pending, .badge.down, .badge.unavailable { background: #ef6c0030; }
.badge.established { background: #2e7d3230; }
.badge.disabled { background: #8883; }
.nowrap { white-space: nowrap; }
.error-text { max-width: 520px; overflow-wrap: anywhere; }
@media (max-width: 900px) {
  body { margin: 12px; }
  .grid { grid-template-columns: 1fr; }
  .form-grid, .forward-grid { grid-template-columns: 1fr; }
}
</style>
</head>
<body>
<h1>dns-route admin</h1>
<p><small>HTTP panel: {{.Message}}</small></p>

<div class="grid">
  <div class="card">
    <h2>Global settings</h2>
    <form method="post" action="/settings/save">
      <table>
        <tr><th>Key</th><th>Value</th></tr>
        <tr><td>wg_interface</td><td><input type="text" name="wg_interface" value="{{index .Settings "wg_interface"}}"></td></tr>
        <tr><td>wg_gateway</td><td><input type="text" name="wg_gateway" value="{{index .Settings "wg_gateway"}}"><br><small>Legacy fallback, mainly for IPv4.</small></td></tr>
        <tr><td>wg_gateway_v4</td><td><input type="text" name="wg_gateway_v4" value="{{index .Settings "wg_gateway_v4"}}"><br><small>Overrides wg_gateway for A routes.</small></td></tr>
        <tr><td>wg_gateway_v6</td><td><input type="text" name="wg_gateway_v6" value="{{index .Settings "wg_gateway_v6"}}"><br><small>AAAA routes are device-only when empty.</small></td></tr>
        <tr>
          <td>route_mode</td>
          <td>
            <select name="route_mode">
              <option value="kernel" {{if eq .Config.RouteMode "kernel"}}selected{{end}}>kernel</option>
              <option value="bgp" {{if eq .Config.RouteMode "bgp"}}selected{{end}}>bgp</option>
              <option value="kernel+bgp" {{if eq .Config.RouteMode "kernel+bgp"}}selected{{end}}>kernel+bgp</option>
            </select><br>
            <small>kernel+bgp installs the exact prefix in the configured kernel table before announcing it.</small>
          </td>
        </tr>
        <tr><td>route_table</td><td><input type="number" min="0" name="route_table" value="{{.Config.RouteTable}}"><br><small>0 means the main table (254). In kernel+bgp this table is mirrored into BGP on startup and manual route reload.</small></td></tr>
        <tr>
          <td>route_ipv4</td>
          <td><input type="hidden" name="route_ipv4" value="0"><label><input type="checkbox" name="route_ipv4" value="1" {{if .Config.RouteIPv4}}checked{{end}}> Program routes from A records</label></td>
        </tr>
        <tr>
          <td>route_ipv6</td>
          <td><input type="hidden" name="route_ipv6" value="0"><label><input type="checkbox" name="route_ipv6" value="1" {{if .Config.RouteIPv6}}checked{{end}}> Program routes from AAAA records</label></td>
        </tr>
        <tr><td>bgp_local_asn</td><td><input type="number" min="1" max="4294967295" name="bgp_local_asn" value="{{if .Config.BGP.LocalASN}}{{.Config.BGP.LocalASN}}{{end}}"></td></tr>
        <tr><td>bgp_router_id</td><td><input type="text" name="bgp_router_id" value="{{.Config.BGP.RouterID}}" placeholder="192.0.2.1"><br><small>Must be a non-zero IPv4 address.</small></td></tr>
        <tr><td>bgp_peer_address</td><td><input type="text" name="bgp_peer_address" value="{{.Config.BGP.PeerAddress}}" placeholder="192.0.2.2 or 2001:db8::2"></td></tr>
        <tr><td>bgp_peer_asn</td><td><input type="number" min="1" max="4294967295" name="bgp_peer_asn" value="{{if .Config.BGP.PeerASN}}{{.Config.BGP.PeerASN}}{{end}}"></td></tr>
        <tr><td>bgp_local_address</td><td><input type="text" name="bgp_local_address" value="{{.Config.BGP.LocalAddress}}"><br><small>Optional source address for the BGP TCP connection.</small></td></tr>
        <tr><td>bgp_next_hop_v4</td><td><input type="text" name="bgp_next_hop_v4" value="{{.Config.BGP.NextHopV4}}" placeholder="192.0.2.1"></td></tr>
        <tr><td>bgp_next_hop_v6</td><td><input type="text" name="bgp_next_hop_v6" value="{{.Config.BGP.NextHopV6}}" placeholder="2001:db8::1"></td></tr>
        <tr><td>bgp_multihop_ttl</td><td><input type="number" min="1" max="255" name="bgp_multihop_ttl" value="{{.Config.BGP.MultihopTTL}}"><br><small>1 for a directly connected eBGP peer.</small></td></tr>
        <tr>
          <td>bgp_password</td>
          <td>
            <input type="password" name="bgp_password" value="" autocomplete="new-password" placeholder="{{if .BGP.PasswordConfigured}}configured — blank keeps current{{else}}not configured{{end}}"><br>
            <label><input type="checkbox" name="bgp_password_clear" value="1"> Clear configured password</label>
          </td>
        </tr>
        <tr>
          <td>bgp_require_established</td>
          <td>
            <input type="hidden" name="bgp_require_established" value="0">
            <label><input type="checkbox" name="bgp_require_established" value="1" {{if .Config.BGP.RequireEstablished}}checked{{end}}> Treat prefixes as ready only while the peer is Established</label>
          </td>
        </tr>
        <tr><td>local_record_ttl</td><td><input type="number" min="0" name="local_record_ttl" value="{{index .Settings "local_record_ttl"}}"></td></tr>
        <tr>
          <td>lookup_cidr</td>
          <td><input type="hidden" name="lookup_cidr" value="0"><label><input type="checkbox" name="lookup_cidr" value="1" {{if .Config.LookupCIDR}}checked{{end}}> Team Cymru BGP prefix lookup</label></td>
        </tr>
        <tr>
          <td>reply_before_route</td>
          <td>
            <input type="hidden" name="reply_before_route" value="0">
            <label><input type="checkbox" name="reply_before_route" value="1" {{if .Config.ReplyBeforeRoute}}checked{{end}}> Reply before route installation</label><br>
            <small>Enabled: answer immediately, install route asynchronously, then reset conntrack only if a route was actually installed. Disabled: wait for route installation; return SERVFAIL on route failure.</small>
          </td>
        </tr>
        <tr>
          <td>listener_freebind</td>
          <td>
            <input type="hidden" name="listener_freebind" value="0">
            <label><input type="checkbox" name="listener_freebind" value="1" {{if .Config.ListenerFreeBind}}checked{{end}}> Bind addresses before they exist</label><br>
            <small>Uses Linux IP_FREEBIND/IPV6_FREEBIND. When disabled, unavailable addresses remain pending and are retried every 3 seconds.</small>
          </td>
        </tr>
      </table>
      <p><button type="submit">Save settings</button></p>
    </form>
  </div>

  <div class="card">
    <h2>Runtime</h2>
    <table>
      <tr><td>Listen addrs</td><td>{{len .Config.ListenAddrs}}</td></tr>
      <tr><td>Default upstreams</td><td>{{len .Config.Upstreams}}</td></tr>
      <tr><td>Conditional forward zones</td><td>{{len .ForwardZones}}</td></tr>
      <tr><td>Special domains</td><td>{{len .SpecialDomains}}</td></tr>
      <tr><td>Local A domains</td><td>{{len .Config.LocalA}}</td></tr>
      <tr><td>Local AAAA domains</td><td>{{len .Config.LocalAAAA}}</td></tr>
      <tr><td>Route mode</td><td>{{.Config.RouteMode}}</td></tr>
      <tr><td>Route table</td><td>{{.Config.RouteTable}}</td></tr>
      <tr><td>Route IPv4</td><td>{{.Config.RouteIPv4}}</td></tr>
      <tr><td>Route IPv6</td><td>{{.Config.RouteIPv6}}</td></tr>
      <tr><td>Team Cymru prefix lookup</td><td>{{.Config.LookupCIDR}}</td></tr>
      <tr><td>Reply before route</td><td>{{.Config.ReplyBeforeRoute}}</td></tr>
      <tr><td>Listener freebind</td><td>{{.Config.ListenerFreeBind}}</td></tr>
      <tr><td>WG interface</td><td>{{.Config.WGInterface}}</td></tr>
      <tr><td>WG gateway</td><td>{{.Config.WGGateway}}</td></tr>
      <tr><td>WG gateway v4</td><td>{{.Config.WGGatewayV4}}</td></tr>
      <tr><td>WG gateway v6</td><td>{{.Config.WGGatewayV6}}</td></tr>
      <tr><td>BGP peer</td><td>{{if .BGP.Enabled}}<span class="badge {{.BGP.State}}">{{.BGP.State}}</span> {{.BGP.PeerAddress}} AS{{.BGP.PeerASN}}{{else}}<span class="badge disabled">disabled</span>{{end}}</td></tr>
      <tr><td>BGP prefixes</td><td>desired: {{.BGP.DesiredPrefixes}}<br>Loc-RIB: {{.BGP.AnnouncedPrefixes}}</td></tr>
      <tr><td>BGP backend ready</td><td>{{.BGP.Ready}}{{if .BGP.RequireEstablished}} <small>(requires Established)</small>{{end}}</td></tr>
    </table>
    <div class="actions">
      <form class="inline" method="post" action="/reload"><button type="submit">Reload config</button></form>
      <form class="inline" method="post" action="/routes/reload"><button type="submit">Reload routes</button></form>
      <button type="button" onclick="location.href='/stats'">Open statistics</button>
      <button type="button" onclick="window.open('/metrics', '_blank')">Prometheus metrics</button>
      <button type="button" onclick="window.open('/routes/errors', '_blank')">Route error log</button>
    </div>
  </div>
</div>

<div class="grid section-gap">
  <div class="card">
    <h2>Listen addresses</h2>
    <form method="post" action="/listen/add">
      <input type="text" name="addr" placeholder="0.0.0.0:53 or [::]:53" required>
      <p><button type="submit">Add listen address</button></p>
    </form>
    <table>
      <tr><th>Configured address</th><th>Action</th></tr>
      {{range .ListenAddrs}}<tr><td>{{.}}</td><td><form class="inline" method="post" action="/listen/delete"><input type="hidden" name="addr" value="{{.}}"><button type="submit">Delete</button></form></td></tr>{{else}}<tr><td colspan="2" class="muted">No listen addresses configured.</td></tr>{{end}}
    </table>
    <h3>Runtime listener state</h3>
    <table>
      <tr><th>Network</th><th>Address</th><th>State</th><th>FreeBind</th><th>Attempts / time</th><th>Last error</th></tr>
      {{range .ListenerStates}}
      <tr>
        <td>{{.Net}}</td>
        <td>{{.Addr}}</td>
        <td><span class="badge {{.State}}">{{.State}}</span></td>
        <td>{{.FreeBind}}</td>
        <td>{{if eq .State "active"}}started: {{.StartedAt}}{{else}}attempts: {{.Attempts}}<br>last: {{.LastAttempt}}{{end}}</td>
        <td class="error-text">{{if .LastError}}{{.LastError}}{{else}}<span class="muted">—</span>{{end}}</td>
      </tr>
      {{else}}<tr><td colspan="6" class="muted">No listener sockets configured.</td></tr>{{end}}
    </table>
  </div>

  <div class="card">
    <h2>Default upstreams</h2>
    <form method="post" action="/upstream/add" class="form-grid">
      <label>Address
        <input type="text" name="addr" placeholder="10.0.0.2:53 or https://dns.google/dns-query" required>
      </label>
      <label>Protocol
        <select name="proto">
          <option value="auto">auto</option>
          <option value="udp">udp</option>
          <option value="tcp">tcp</option>
          <option value="tls">tls / DoT</option>
          <option value="https">https / DoH</option>
        </select>
      </label>
      <button type="submit">Add / update</button>
    </form>
    <p><small>Used only when no conditional forwarding zone matches. With auto: https URL → DoH; port 853 → DoT; other addresses → UDP DNS. UDP automatically retries truncated replies over TCP.</small></p>
    <table>
      <tr><th>Upstream</th><th>Configured</th><th>Effective</th><th>Circuit</th><th>Failures</th><th>Action</th></tr>
      {{range .Upstreams}}
      <tr>
        <td><strong>{{.Addr}}</strong><br><small>{{.Endpoint}}</small></td>
        <td>{{.ConfiguredProto}}</td>
        <td>{{.Proto}}</td>
        <td class="nowrap"><span class="badge {{.State}}">{{.State}}</span>{{if ne .OpenRemaining "—"}}<br><small>{{.OpenRemaining}} remaining</small>{{end}}</td>
        <td>{{.ConsecutiveFailures}}{{if .LastError}}<br><small class="error-text" title="{{.LastError}}">{{.LastError}}</small>{{end}}</td>
        <td><form class="inline" method="post" action="/upstream/delete"><input type="hidden" name="addr" value="{{.Addr}}"><button type="submit">Delete</button></form></td>
      </tr>
      {{else}}<tr><td colspan="6" class="muted">No upstreams configured.</td></tr>{{end}}
    </table>
  </div>
</div>

<div class="card section-gap">
  <h2>Conditional forwarding</h2>
  <form method="post" action="/forward-zone/add" class="form-grid forward-grid">
    <label>Domain suffix
      <input type="text" name="domain" placeholder="*.ru or *.lan" required>
    </label>
    <label>Upstream
      <input type="text" name="addr" placeholder="77.88.8.8:53 or 127.0.0.1:5353" required>
    </label>
    <label>Protocol
      <select name="proto">
        <option value="auto">auto</option>
        <option value="udp">udp</option>
        <option value="tcp">tcp</option>
        <option value="tls">tls / DoT</option>
        <option value="https">https / DoH</option>
      </select>
    </label>
    <button type="submit">Add / update</button>
  </form>
  <p><small>Rules match the queried name by suffix; the longest suffix wins. <code>*.ru</code>, <code>.ru</code>, and <code>ru</code> are normalized to the same zone. A matched zone never falls back to the default upstream set, preventing private names such as <code>*.lan</code> from leaking to public DNS. Add the same zone again with another address to create a load-balanced pool.</small></p>
  {{range .ForwardZones}}
  <h3>{{.Pattern}}</h3>
  <table>
    <tr><th>Upstream</th><th>Configured</th><th>Effective</th><th>Circuit</th><th>Failures</th><th>Action</th></tr>
    {{range .Upstreams}}
    <tr>
      <td><strong>{{.View.Addr}}</strong><br><small>{{.View.Endpoint}}</small></td>
      <td>{{.View.ConfiguredProto}}</td>
      <td>{{.View.Proto}}</td>
      <td class="nowrap"><span class="badge {{.View.State}}">{{.View.State}}</span>{{if ne .View.OpenRemaining "—"}}<br><small>{{.View.OpenRemaining}} remaining</small>{{end}}</td>
      <td>{{.View.ConsecutiveFailures}}{{if .View.LastError}}<br><small class="error-text" title="{{.View.LastError}}">{{.View.LastError}}</small>{{end}}</td>
      <td><form class="inline" method="post" action="/forward-zone/upstream/delete"><input type="hidden" name="id" value="{{.ID}}"><button type="submit">Delete upstream</button></form></td>
    </tr>
    {{else}}<tr><td colspan="6" class="muted">No upstreams. This empty zone is ignored until an upstream is added.</td></tr>{{end}}
  </table>
  <div class="actions"><form class="inline" method="post" action="/forward-zone/delete"><input type="hidden" name="id" value="{{.ID}}"><button type="submit">Delete zone {{.Pattern}}</button></form></div>
  {{else}}<p class="muted">No conditional forwarding zones configured.</p>{{end}}
</div>

<div class="card section-gap">
  <h2>Special domains</h2>
  <form method="post" action="/special/add">
    <input type="text" name="domain" placeholder="example.com" required>
    <p><button type="submit">Add special domain</button></p>
  </form>
  <table>
    <tr><th>Domain</th><th>Action</th></tr>
    {{range .SpecialDomains}}<tr><td>{{.}}</td><td><form class="inline" method="post" action="/special/delete"><input type="hidden" name="domain" value="{{.}}"><button type="submit">Delete</button></form></td></tr>{{else}}<tr><td colspan="2" class="muted">No special domains configured.</td></tr>{{end}}
  </table>
</div>

<div class="card section-gap">
  <h2>DNS records</h2>
  <form method="post" action="/record/add">
    <table>
      <tr>
        <td><input type="text" name="name" placeholder="example.com or *.example.com" required></td>
        <td><select name="type"><option value="A">A</option><option value="AAAA">AAAA</option></select></td>
        <td><input type="text" name="value" placeholder="10.0.0.1, 2001:db8::1, or empty=NODATA"></td>
        <td><input type="number" min="0" name="ttl" placeholder="0"></td>
        <td><button type="submit">Add record</button></td>
      </tr>
    </table>
  </form>
  <table>
    <tr><th>ID</th><th>Name</th><th>Type</th><th>Value</th><th>TTL</th><th>Action</th></tr>
    {{range .Records}}<tr><td>{{.ID}}</td><td>{{.Name}}</td><td>{{.Type}}</td><td>{{.Value}}</td><td>{{.TTL}}</td><td><form class="inline" method="post" action="/record/delete"><input type="hidden" name="id" value="{{.ID}}"><button type="submit">Delete</button></form></td></tr>{{else}}<tr><td colspan="6" class="muted">No local DNS records configured.</td></tr>{{end}}
  </table>
</div>
</body>
</html>
